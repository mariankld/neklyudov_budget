PORT=3000

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Optional: model used for photo/receipt parsing (defaults to gpt-4o, which reads small/blurry
# text more reliably than gpt-4o-mini). Only set this to override.
OPENAI_VISION_MODEL=gpt-4o

# Google Sheets — enable Google Sheets API; OAuth client with scope https://www.googleapis.com/auth/spreadsheets
# Run once: npm run google-oauth-setup — paste GOOGLE_REFRESH_TOKEN below.
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3001/oauth/callback

# RAW tab title (default RAW). Summary is never written by the bot.
RAW_SHEET_NAME=RAW

# When the spreadsheet only has Summary + RAW (no per-category tabs), list every category name
# here—comma, pipe, or newline separated. Must include the same name as INCOME_SHEET_NAME for income.
# Example: Food,Transport,Shopping,Healthcare,Entertainment,Income
GOOGLE_CATEGORY_LIST=

# Logical label for income rows in RAW column "category" (default Income).
INCOME_SHEET_NAME=Income

# Optional: pipe- or comma-separated tab names to exclude from category discovery (legacy: one tab per category).
# The RAW tab is excluded automatically. Ignored when GOOGLE_CATEGORY_LIST is set.
GOOGLE_SKIP_TABS=

# Microsoft Graph / Excel (SharePoint) — replacing Google Sheets as the source of truth.
# Requires an Entra ID app registration with admin-consented Files.ReadWrite.All (or
# Sites.ReadWrite.All) application permission. See README "Migrating to Excel via
# Microsoft Graph" for setup steps.
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_ID=your_azure_app_client_id
AZURE_CLIENT_SECRET=your_azure_app_client_secret
EXCEL_SHARE_URL=https://yourtenant-my.sharepoint.com/:x:/g/personal/.../...

# Filled in by `npm run resolve-excel-share` once admin consent is granted:
EXCEL_DRIVE_ID=
EXCEL_ITEM_ID=
