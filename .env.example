PORT=3000

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.5-medium

# Microsoft Graph (app registration with Files.ReadWrite.All or equivalent)
MS_TENANT_ID=your_tenant_id
MS_CLIENT_ID=your_client_id
MS_CLIENT_SECRET=your_client_secret

# OneDrive + Excel
ONEDRIVE_DRIVE_ID=your_drive_id
EXCEL_FILE_ID=your_excel_file_id

# The code writes to table name: <EXCEL_TABLE_NAME_PREFIX><sheetName>
# Example: prefix "tbl_" => "tbl_Shopping", "tbl_Доходы", "tbl_Expenses_RAW"
EXCEL_TABLE_NAME_PREFIX=tbl_

# Pipe-separated category tabs used by parser (include all your expense + income tabs)
# Example: Shopping|Транспорт|...|Доходы
ALLOWED_CATEGORIES=Shopping|Транспорт|Utilities|Развлечения|Рестораны|Семья и персонал|Расходы Персонал|Прочее|Связь и подписки|Путешествия|Здоровье|Образование|Аренда|Мед. страховка|CAPEX|Credit Cards|Доходы
